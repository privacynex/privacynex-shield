# ═══════════════════════════════════════════════════════════════════════════
# Node.js
# ═══════════════════════════════════════════════════════════════════════════

# Dependencies
node_modules/
jspm_packages/
.pnpm-store/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.pid.lock
*.seed

# Coverage and test output
coverage/
*.lcov
.nyc_output

# Cache
.cache
.parcel-cache
*.tsbuildinfo
.eslintcache
.npm
.node_repl_history
.yarn-integrity

# Packed artifacts
*.tgz

# NOTE: dist/ is intentionally NOT ignored.
# The published build is committed and validated by `npm run verify:dist`.

# ═══════════════════════════════════════════════════════════════════════════
